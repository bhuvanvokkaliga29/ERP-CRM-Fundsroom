generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  OVERDUE
  CANCELLED
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum MovementType {
  IN
  OUT
}

enum MovementReason {
  INITIAL_STOCK
  PURCHASE
  SALES_CHALLAN
  SALES_RETURN
  MANUAL_ADJUSTMENT
  CORRECTION
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  INVOICED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  FOLLOWUP_DUE
  FOLLOWUP_OVERDUE
  CHALLAN_CONFIRMED
  INVOICE_CREATED
  ANOMALY_DETECTED
  SYSTEM
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  DETECTED
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  assignedFollowUps   CustomerFollowUp[] @relation("AssignedFollowUps")
  createdFollowUps    CustomerFollowUp[] @relation("CreatedFollowUps")
  challans            Challan[]
  invoices            Invoice[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  salesReturns        SalesReturn[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Customer {
  id            String         @id @default(uuid())
  customerName  String
  mobileNumber  String
  email         String?
  businessName  String?
  gstNumber     String?
  customerType  CustomerType   @default(RETAIL)
  address       String?
  status        CustomerStatus @default(LEAD)
  followUpDate  DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  followUps     CustomerFollowUp[]
  challans      Challan[]
  invoices      Invoice[]
  returns       SalesReturn[]

  @@index([email])
  @@index([mobileNumber])
  @@index([status])
  @@index([customerType])
  @@index([followUpDate])
  @@index([businessName])
  @@map("customers")
}

model CustomerFollowUp {
  id            String         @id @default(uuid())
  customerId    String
  assignedToId  String
  scheduledAt   DateTime
  completedAt   DateTime?
  status        FollowUpStatus @default(SCHEDULED)
  type          FollowUpType   @default(CALL)
  note          String?
  outcome       String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  customer      Customer  @relation(fields: [customerId], references: [id])
  assignedTo    User      @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  createdBy     User      @relation("CreatedFollowUps", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@index([status])
  @@map("customer_follow_ups")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  products  Product[]

  @@map("categories")
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String    @unique
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  products  Product[]

  @@map("warehouses")
}

model Product {
  id                        String        @id @default(uuid())
  productName               String
  sku                       String        @unique
  description               String?
  categoryId                String
  warehouseId               String
  unitPrice                 Decimal       @db.Decimal(12, 2)
  costPrice                 Decimal?      @db.Decimal(12, 2)
  taxRate                   Decimal       @default(18) @db.Decimal(5, 2)
  currentStock              Int           @default(0)
  reservedStock             Int           @default(0)
  minimumStockAlertQuantity Int           @default(10)
  imageUrl                  String?
  status                    ProductStatus @default(ACTIVE)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  // Relations
  category        Category        @relation(fields: [categoryId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  stockMovements  StockMovement[]
  challanItems    ChallanItem[]
  invoiceItems    InvoiceItem[]
  returnItems     SalesReturnItem[]

  @@index([sku])
  @@index([categoryId])
  @@index([warehouseId])
  @@index([status])
  @@index([currentStock])
  @@map("products")
}

model StockMovement {
  id              String         @id @default(uuid())
  productId       String
  quantityChanged Int
  movementType    MovementType
  reason          MovementReason
  referenceType   String?
  referenceId     String?
  note            String?
  createdById     String
  createdAt       DateTime       @default(now())

  // Relations
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([movementType])
  @@index([reason])
  @@map("stock_movements")
}

model Challan {
  id              String        @id @default(uuid())
  challanNumber   String        @unique
  customerId      String
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(12, 2)
  status          ChallanStatus @default(DRAFT)
  notes           String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  customer    Customer      @relation(fields: [customerId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       ChallanItem[]
  invoices    Invoice[]
  returns     SalesReturn[]

  @@index([challanNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("challans")
}

model ChallanItem {
  id                  String  @id @default(uuid())
  challanId           String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  taxRateSnapshot     Decimal @db.Decimal(5, 2)
  quantity            Int
  lineSubtotal        Decimal @db.Decimal(12, 2)
  lineTax             Decimal @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)

  // Relations
  challan  Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])

  @@index([challanId])
  @@index([productId])
  @@map("challan_items")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  challanId      String
  customerId     String
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  grandTotal     Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  paidAt         DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  challan   Challan       @relation(fields: [challanId], references: [id])
  customer  Customer      @relation(fields: [customerId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@index([invoiceNumber])
  @@index([challanId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id                  String  @id @default(uuid())
  invoiceId           String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  taxRateSnapshot     Decimal @db.Decimal(5, 2)
  quantity            Int
  lineSubtotal        Decimal @db.Decimal(12, 2)
  lineTax             Decimal @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)

  // Relations
  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model SalesReturn {
  id              String       @id @default(uuid())
  returnNumber    String       @unique
  challanId       String
  customerId      String
  reason          String?
  status          ReturnStatus @default(PENDING)
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  challan   Challan           @relation(fields: [challanId], references: [id])
  customer  Customer          @relation(fields: [customerId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])
  items     SalesReturnItem[]

  @@index([returnNumber])
  @@index([challanId])
  @@index([customerId])
  @@index([status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                  String  @id @default(uuid())
  returnId            String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)

  // Relations
  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@map("sales_return_items")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Anomaly {
  id          String          @id @default(uuid())
  type        String
  severity    AnomalySeverity
  entityType  String
  entityId    String?
  explanation String
  status      AnomalyStatus   @default(DETECTED)
  detectedAt  DateTime        @default(now())
  metadata    Json?

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@map("anomalies")
}

model AIInsight {
  id          String   @id @default(uuid())
  insightType String
  entityType  String?
  entityId    String?
  content     Json
  sourceData  Json?
  generatedAt DateTime @default(now())

  @@index([insightType])
  @@index([generatedAt])
  @@map("ai_insights")
}
